# Port for the Node.js server (default: 4188)
RAYBAN_PORT=4188

# Host address to bind to (use 0.0.0.0 in Docker/containers, 127.0.0.1 for local/reverse-proxy)
RAYBAN_HOST=127.0.0.1

# Comma-separated list of allowed production domains for the admin panel API
RAYBAN_ALLOWED_ORIGINS=https://rayban.studio

# Set to 1 to enable Secure flag on admin session cookies over HTTPS
RAYBAN_SECURE_COOKIE=1

# Set to 1 to allow creating the initial admin account from any remote IP (disabled by default)
RAYBAN_ALLOW_REMOTE_SETUP=0
